# RichMonks market API base URL (no trailing slash required).
# Ticker reads {BASE}/viewFinsparcScoreCard/all/all
NEXT_PUBLIC_MARKET_API_BASE_URL=

# Public CDN base for stock logos: {BASE}/{SYMBOL}.png
# Trailing slash is optional (helper normalizes it).
# Leave empty to fall back to the initial-letter badge in the ticker.
NEXT_PUBLIC_CDN_BASE_URL=
